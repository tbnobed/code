{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:image-versions": "esbuild src/lib/generated-image-artifact.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/forge-image-artifact.test.cjs && esbuild ../agent/src/lib/generated-image-preview.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/forge-image-preview.test.cjs && node --test /tmp/forge-image-artifact.test.cjs /tmp/forge-image-preview.test.cjs",
    "test:verification": "esbuild src/lib/preview-verification.test.ts src/lib/agent-verification.test.ts src/lib/agent-completion.integration.test.ts --bundle --platform=node --format=cjs --outdir=/tmp/forge-verification-tests && NODE_ENV=production SESSION_SECRET=forge-disposable-test-secret node --test /tmp/forge-verification-tests/*.js",
    "test:research-images": "esbuild src/lib/research-images.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/forge-research-images.cjs && node --test /tmp/forge-research-images.cjs",
    "test:database": "esbuild src/lib/project-database.integration.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/forge-project-db-test.cjs && node --test /tmp/forge-project-db-test.cjs",
    "test:platform": "esbuild src/lib/platform-context.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/forge-platform-tests.cjs && node --test /tmp/forge-platform-tests.cjs",
    "test:runtime": "esbuild src/lib/runtime.test.ts src/lib/framework-preview.test.ts --bundle --platform=node --format=cjs --outdir=/tmp/forge-runtime-tests && node --test /tmp/forge-runtime-tests/*.js",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "openai": "^5.0.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
